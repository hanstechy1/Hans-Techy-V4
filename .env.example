# HANS TECHY V4 - copy to .env locally or set as deployment Config Vars.
# Never commit .env or real credentials.
BOT_NAME=HANS TECHY V4
PREFIX=.
OWNER_NUMBER=2557XXXXXXXX
MODE=public
PORT=3000
DATABASE_URL=

# Generate keys independently with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
AUTH_STATE_ENCRYPTION_KEY=
REQUIRE_AUTH_STATE_ENCRYPTION=false
ADMIN_TOKEN=
PUBLIC_PAIRING=false
MAX_SESSIONS=5
PAIR_RATE_LIMIT=5
PAIR_RATE_WINDOW_MS=900000
TRUST_PROXY=false
PGPOOL_MAX=10
PGSSL_REJECT_UNAUTHORIZED=false

LIMIT_USER=20
LIMIT_PREMIUM=200
MAX_PROMPT_CHARS=12000
AI_TIMEOUT_MS=45000

# Private GitHub repo containing encrypted keys.enc
KEYS_REPO=owner/Key
KEYS_REPO_TOKEN=
KEYS_ENCRYPTION_KEY=
KEYS_FILE=keys.enc
KEYS_REF=main
KEYS_ALLOW_PLAIN=false

ALLOW_SHARED_KEYS=false
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
